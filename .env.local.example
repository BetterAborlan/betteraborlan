# Copy to .env.local for local dev. In Vercel, set these as Project → Settings → Environment Variables.

# Public site URL, used in metadata/OpenGraph
NEXT_PUBLIC_SITE_URL=https://betteraborlan.org

# Set to "true" ONLY in Vercel's Production environment vars to show a
# coming-soon page instead of the full site. Leave unset locally and in
# Development/Preview. Flip to "false" (or remove) in Production to launch.
NEXT_PUBLIC_COMING_SOON=false

# Government API keys (add as integrations are wired up)
# PSA_API_KEY=
# DATA_GOV_PH_API_KEY=
